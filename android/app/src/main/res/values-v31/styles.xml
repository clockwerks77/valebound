<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw their own launch screen: an icon on a
         colour. Both are set here, so it is the lantern on deep green. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/vale_forest</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/vale_forest</item>
    </style>
</resources>
