<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process is starting. The same in light and
         dark mode: the app has one look. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The window once the app is running, and behind it while it draws
         or resizes (opening and closing the Fold). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/vale_forest</item>
    </style>
</resources>
